{
  "$schema": "pando-assistant design tokens v1",
  "name": "Pando Living Organism",
  "color": {
    "bosque":        { "value": "#0F2A20", "role": "window background, ink on light surfaces (brand)" },
    "bosqueDeep":    { "value": "#0A1F17", "role": "recessed panels, code blocks" },
    "marfil":        { "value": "#F4F1E8", "role": "primary text, membrane stroke (brand: never pure white)" },
    "alamo":         { "value": "#E9B949", "role": "nucleus, Pando engine, accent on dark (brand)" },
    "alamoOscuro":   { "value": "#C68A17", "role": "accent on light backgrounds only, never text (brand)" },
    "alamoText":     { "value": "#8F6310", "role": "AA-contrast accent for text/controls in light mode (brand)" },
    "claudeBlue":    { "value": "#8FB8DE", "role": "Claude Code engines (ACP + external session). Brand extension adopted as default 2026-10-12, pending product-owner sign-off (PDA-T-0017)" },
    "bermellon":     { "value": "#E5533D", "role": "error nucleus, error ring. Brand extension adopted as default 2026-10-12, pending product-owner sign-off (PDA-T-0017)" },
    "marfilAlpha": {
      "62": "rgba(244,241,232,0.62)",
      "45": "rgba(244,241,232,0.45)",
      "22": "rgba(244,241,232,0.22)",
      "12": "rgba(244,241,232,0.12)",
      "07": "rgba(244,241,232,0.07)",
      "note": "Only Marfil at alpha is used for secondary text, hairlines and membrane fills. No greys."
    }
  },
  "typography": {
    "display": { "family": "Space Grotesk", "weights": [400, 500, 600], "use": "wordmark, state label, agent name" },
    "mono":    { "family": "JetBrains Mono", "weights": [300, 400, 500], "use": "labels, eyebrows, streams, probabilities, keyboard hints" },
    "body":    { "family": "Zen Kaku Gothic New", "weights": [300, 400, 500], "use": "UI copy; light weight by default", "fallback": "system-ui, sans-serif" },
    "scale": { "eyebrow": 10, "label": 11, "hint": 12, "body": 13, "bodyLg": 14, "transcript": 18, "stateLabel": 19, "wordmark": 21 },
    "eyebrowStyle": { "letterSpacing": "0.16em", "transform": "uppercase", "weight": 300, "color": "marfilAlpha.62" }
  },
  "space":  { "unit": 4, "cardPad": [20, 22], "gap": 14, "sectionGap": 32, "pagePad": [24, 32] },
  "radius": { "pill": 999, "card": 22, "control": 999 },
  "stroke": { "hairline": 1, "membrane": 1.5, "membraneHalo": 7, "pseudopod": 1.6, "pseudopodHalo": 9, "cell": 1.3, "ring": 1 },
  "motion": {
    "springEase": "cubic-bezier(0.34, 1.9, 0.5, 1)",
    "springEaseSoft": "cubic-bezier(0.34, 1.5, 0.5, 1)",
    "durations": { "hover": 0.3, "stateMorph": 0.9, "nucleusMorph": 0.9, "cellBirth": 1.6, "waveLife": 1.8, "cellDeath": 0.6, "removeTerminalAfter": 10, "delegatingOverlay": 1.5 },
    "physics": {
      "cellSpringK": 3.5, "cellSpringKNewborn": 2.2, "cellDampingPerSecond": 0.08, "cellPositionGain": 4,
      "nucleusFollowLerp": 0.08, "amplitudeLerpPerSecond": 12, "hoverLerpPerSecond": 10,
      "note": "nucleusFollowLerp is the lerp factor per 60 Hz frame; the port applies it frame-rate independently as 1-(1-0.08)^(60*dt). Angular speeds in this file are rad/s, never Hz."
    }
  },
  "organism": {
    "canvasAspect": "1:1",
    "habitatRadius": 0.47,
    "ringRadius": 0.36,
    "bodyRadius": 0.13,
    "bodyRadiusByState": { "idle": 1.0, "listening": 1.06, "thinking": 0.97, "speaking": 1.08, "delegating": 1.0 },
    "membraneNoise": { "amplitude": 0.05, "breath": 0.012, "breathRadPerSecond": 1.3, "harmonics": [[3, 0.7, 0.5], [5, -1.1, 0.3], [8, 0.45, 0.2]], "phaseMultipliers": [1, 2.1, 0.7], "note": "[angularFreq, timeFreq, weight]; sum of sines, periodic in angle. Breathing period = 2π/1.3 ≈ 4.8 s" },
    "voiceRipple": { "amplitude": 0.16, "angular": [11, 7], "temporal": [14, -9] },
    "bulgeTowardCell": { "amount": 0.16, "sigma": 0.16, "deadFactor": 0.35, "birthExtra": 1.6, "birthSeconds": 2.2 },
    "nucleusRadius": 0.028,
    "nucleusFollowMax": 0.04,
    "nucleusScale": { "ampGain": 0.9, "thinkingPulse": { "amount": 0.12, "radPerSecond": 7 }, "otherPulse": { "amount": 0.04, "radPerSecond": 2 }, "note": "nr = nucleusRadius·W·(1 + ampGain·amp + pulse); no fixed per-state scale" },
    "organelles": { "count": 70, "sizeMin": 0.8, "sizeMax": 2.4, "speedByState": { "idle": 1, "thinking": 3, "speaking": 1.8 } },
    "pseudopod": { "samples": 18, "wobble": 6, "wobbleDead": 2, "wobbleVoiceGain": 2.5, "vesicles": 7, "flowSpeed": { "working": 0.28, "waiting": -0.22, "thinkingMultiplier": 2.2 } },
    "cellRadius": 0.03,
    "cellHoverScale": 1.25,
    "cellNoise": { "working": 0.08, "other": 0.04 },
    "cellNucleusRatio": 0.34,
    "cellBeat": { "radPerSecond": 3.2, "amount": 0.18, "note": "≈0.51 Hz; 1 + amount·max(0, sin(radPerSecond·t + phase))³" },
    "cellBlink": { "radPerSecond": 5, "minAlpha": 0.3, "note": "waiting: square wave on sin(5t) > 0, ≈0.8 Hz" },
    "errorTremor": { "radPerSecond": 18, "amount": 0.08, "nucleusRatio": 0.38, "note": "≈2.9 Hz" },
    "pendingAlpha": 0.6,
    "ring": { "minSlots": 6, "maxCells": 12, "compactAfterSeconds": 10, "slotOffset": 0.15, "note": "stable slots; beyond maxCells an aggregate +N cell collects the oldest done/paused cells (never waiting or error)" },
    "scaling": { "referenceWidth": 640, "minStrokeDevicePx": 0.75, "minHaloPx": 2, "hideLabelsBelow": 200, "minHitRadiusPx": 12, "note": "unscaled pixel constants scale linearly with W/referenceWidth, clamped by these floors" },
    "voiceEnvelope": {
      "idle": 0.10, "thinking": 0.18,
      "listening": "0.35 + 0.45*|sin(6.3t)*sin(1.7t)|",
      "speaking":  "0.30 + 0.50*|sin(9.1t)*cos(2.3t)|",
      "note": "Replace with real RMS from the mic (listening) or the TTS output buffer (speaking), normalised 0..1 and smoothed with amplitudeLerpPerSecond."
    },
    "waves": { "speed": 0.28, "decayPerSecond": 0.55, "speakingRatePerSecond": 2.2, "emitOn": ["enterSpeaking", "enterDelegating", "cellBirth"], "note": "no idle or listening ripples" }
  },
  "engines": {
    "pando":    { "nucleus": "alamo",      "fill": true,  "membrane": "solid",  "canTalk": true,  "label": "Pando" },
    "acp":      { "nucleus": "claudeBlue", "fill": true,  "membrane": "solid",  "canTalk": true,  "label": "Claude Code · ACP" },
    "external": { "nucleus": "claudeBlue", "fill": false, "membrane": "solid",  "canTalk": true,  "label": "Claude Code · external session" },
    "cli":      { "nucleus": "marfil",     "fill": false, "membrane": "dashed", "canTalk": false, "label": "CLI · spore, output only" }
  },
  "status": {
    "pending": { "cellAlpha": 0.6, "nucleus": "still", "pseudopod": "flow outward", "badge": null },
    "working": { "nucleus": "beats 3.2 rad/s", "membrane": "wobble 0.08", "pseudopod": "flow outward", "badge": null },
    "waiting": { "nucleus": "blinks, square on sin(5t), ≈0.8 Hz", "pseudopod": "flow inward, marfil vesicles", "badge": "?" },
    "paused":  { "cellAlpha": 0.35, "pseudopod": "still, alpha 0.3", "badge": "II" },
    "done":    { "nucleus": "marfil 45%", "pseudopod": "still", "badge": "✓" },
    "error":   { "nucleus": "bermellon, tremor 18 rad/s (≈2.9 Hz)", "pseudopod": "still", "badge": "!" , "badgeColor": "bermellon" }
  }
}
